diff --git a/workflow/lib/local_assets.py b/workflow/lib/local_assets.py
new file mode 100644
index 0000000..0b04ebe
--- /dev/null
+++ b/workflow/lib/local_assets.py
@@ -0,0 +1,125 @@
+"""Resolve the installed workflow's declared resources before registering downloads."""
+
+from itertools import product
+import shlex
+import sys
+from pathlib import Path
+from string import Formatter
+
+
+def file_is_present(path):
+    path = Path(path)
+    return path.is_file() and path.stat().st_size > 0
+
+
+def directory_is_cached(folder, filenames):
+    folder = Path(folder)
+    if not folder.exists():
+        return False
+    missing = [folder / name for name in filenames if not file_is_present(folder / name)]
+    if missing:
+        raise FileNotFoundError(
+            f"Incomplete HippUnfold resource cache at {folder}; missing or empty: "
+            + ", ".join(map(str, missing))
+            + ". Repair this declared cache before reuse."
+        )
+    return True
+
+
+def template_is_cached(cache, template, config):
+    spec = config["template_files"][template]
+    values = {
+        "hemi": spec["hemi_wildcards"],
+        "dir": ("AP", "PD", "IO"),
+        "label": config["autotop_labels"],
+        "modality": [name for name in ("T1w", "T2w") if name in spec],
+    }
+    filenames = set()
+    for pattern in spec.values():
+        if not isinstance(pattern, str):
+            continue
+        fields = sorted({name for _, name, _, _ in Formatter().parse(pattern) if name})
+        for combination in product(*(values[name] for name in fields)):
+            filenames.add(pattern.format(**dict(zip(fields, combination))))
+    return directory_is_cached(Path(cache) / "template" / template, sorted(filenames))
+
+
+def atlas_filenames(atlas, config):
+    # Atlas metrics are registration inputs at unfoldreg_density; participant
+    # metrics at output_density are computed by the workflow, not copied here.
+    registration_density = config["unfoldreg_density"]
+    densities = sorted((set(config["output_density"]) | {registration_density}) - {"native"})
+    filenames = []
+    for hemi, label in product(config["hemi"], config["autotop_labels"]):
+        prefix = f"tpl-{atlas}_hemi-{hemi}"
+        for density, surface in product(densities, ("inner", "midthickness", "outer")):
+            filenames.append(
+                f"{prefix}_space-unfold_den-{density}_label-{label}_{surface}.surf.gii"
+            )
+        for metric in config["atlas_metadata"][atlas]["metric_wildcards"]:
+            filenames.append(
+                f"{prefix}_den-{registration_density}_label-{label}_{metric}.shape.gii"
+            )
+        if label == "hipp":
+            for density in densities:
+                filenames.append(f"{prefix}_den-{density}_label-hipp_dseg.label.gii")
+    return filenames
+
+
+def atlas_copy_is_cached(cache, atlas, config):
+    folder = Path(cache) / "atlases" / f"tpl-{atlas}"
+    return all(file_is_present(folder / name) for name in atlas_filenames(atlas, config))
+
+
+def atlas_extract_is_cached(cache, atlas, config):
+    folder = Path(cache) / "atlases_dl" / f"tpl-{atlas}"
+    return directory_is_cached(folder, atlas_filenames(atlas, config))
+
+
+def model_is_unpacked(folder, model):
+    folder = Path(folder)
+    if model["arch_version"] != "nnunet_v1" or not folder.exists():
+        return False
+    training = (
+        folder / "nnUNet" / "3d_fullres" / model["task"]
+        / f"{model['trainer']}__nnUNetPlansv2.1"
+    )
+    if not training.is_dir():
+        raise FileNotFoundError(f"Incomplete HippUnfold model cache: {training}")
+    # nnUNet v1 discovers every fold in this exact model directory. Check all
+    # discovered folds; directory order never selects a checkpoint or a variant.
+    folds = [
+        child for child in training.iterdir()
+        if child.is_dir() and (child.name == "all" or child.name.startswith("fold_"))
+    ]
+    if not folds:
+        raise FileNotFoundError(f"Incomplete HippUnfold model cache: no folds in {training}")
+    checkpoint = model["checkpoint"]
+    names = ["plans.pkl"]
+    for fold in folds:
+        names.extend((f"{fold.name}/{checkpoint}.model", f"{fold.name}/{checkpoint}.model.pkl"))
+    return directory_is_cached(training, names)
+
+
+def gpu_inference_prefix(slot_name, slots=1):
+    """Hold one of the declared host-local GPU slots through inference exec."""
+    if slots < 1:
+        raise ValueError("GPU slot count must be positive")
+    code = r'''import errno,os,socket,sys,time
+slot=socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+while True:
+    for index in range(int(sys.argv[2])):
+        try:
+            slot.bind("\0" + sys.argv[1] + ("" if index == 0 else "-" + str(index)))
+            break
+        except OSError as exc:
+            if exc.errno != errno.EADDRINUSE:
+                raise
+    else:
+        time.sleep(0.2)
+        continue
+    break
+slot.set_inheritable(True)
+os.execvp(sys.argv[3], sys.argv[3:])
+'''
+    return shlex.join([sys.executable, "-S", "-c", code, slot_name, str(slots)])
