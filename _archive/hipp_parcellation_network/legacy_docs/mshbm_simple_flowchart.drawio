<mxfile host="app.diagrams.net" modified="2026-04-20T00:00:00.000Z" agent="codex" version="24.7.17" type="device">
  <diagram id="mshbm-flow" name="MSHBM Simple Flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="MSHBM (Kong-style) 简化流程图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="s0" value="输入数据&#xa;海马 run-wise 时序 + 参考网络标签" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="m0" value="FC matrix X(v,d)&#xa;v=海马顶点, d=参考维度&#xa;[ ■ ■ ■ ... ]&#xa;[ ■ ■ ■ ... ]" style="shape=mxgraph.basic.matrix;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="Step 1 初始化&#xa;ROI交集 + 球面kmeans&#xa;得到初始 cluster / lambda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="650" y="100" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="Step 2 组层 EM&#xa;E-step: 更新 lambda&#xa;M-step: 更新 mu, sigma, eps, kappa, theta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="340" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="mu(:,n) 模板向量&#xa;n=网络, 每列是网络“指纹”&#xa;[0.12&#xa; 0.03&#xa; 0.27 ...]" style="shape=mxgraph.basic.matrix;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="730" y="240" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="m2" value="theta(v,n) = Group Prior&#xa;每个顶点对各网络的先验概率&#xa;行归一化" style="shape=mxgraph.basic.matrix;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="980" y="240" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="Tune (w, c)&#xa;validation上网格搜索&#xa;w: prior权重, c:平滑权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="650" y="410" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s4" value="Step 3 个体推断&#xa;score = 数据项 + w*log(theta) - c*平滑项&#xa;输出 posterior + labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="960" y="410" width="340" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s5" value="展示/汇报重点&#xa;1) theta 空间模式&#xa;2) WTA occupancy&#xa;3) inter vs intra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="960" y="550" width="340" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="n1" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s0" target="m0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="m0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n4" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s2" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s2" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n6" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="m2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
