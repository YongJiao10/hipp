# GitHub tracks source, documentation, configuration and tests.
# Generated data and result files remain local.
*
!*/
!.gitignore
!Makefile
!*.py
!*.sh
!*.bash
!*.m
!*.r
!*.R
!*.md
!*.toml
!*.yaml
!*.yml
!*.ini
!*.cfg
!*.lut
!*.css
!*.js
!*.cjs
!*.ts
!*.tsx
!*.jsx
!*.ipynb
!/*.html
!/config/**
!/environment/**
!/manifests/**
!/tests/**
!**/config/**
!/.vscode/settings.json
!/scripts/core_workflow/step_registry.json
!/scripts/core_workflow/lib/hippunfold_local_assets.patch
!/scripts/core_workflow/lib/snakemake_local_source_cache.patch
!/scripts/visualize/flowchart/package.json
!/scripts/visualize/flowchart/compact/layout.json
!/scripts/visualize/flowchart/compact/asset_details.json
!/scripts/visualize/flowchart/compact/assets/*.png
!/stanford_jjtms_multiscale_hippocampal_exploration/kember_metrics/source_lock.json

# Local datasets, products, dependencies, archives and agent state.
/outputs*/
/wrong/
/present*/
/data/
/external/
/software/
/runtime/
/.runtime_py/
/.cache/
/.worktrees/
/ctxreg_worktree/
/tmp/
/temp_*/
/logs/
/refs/
/.claude/
/.codex/
/.pi/
/.agents/
/.aws/
/.pytest_cache/
/.ruff_cache/
**/*archive*/
**/__pycache__/
**/.ipynb_checkpoints/
*.pyc
*.backup*
*.bundle
*.orig
*.rej
*.pptx
*.pptx.bak

# Do not traverse generated result trees or nested dependency caches.
**/work/
**/runs/
**/results/
**/stats/
**/reports/
**/contrasts/
**/ttest_cache/
**/node_modules/
**/.pytest_cache/
**/.ruff_cache/
/.superpowers/

# Local presentation sources and nested agent/runtime installations.
/docs/presentations/
**/.runtime_py/
**/runtime/
**/.superpowers/
